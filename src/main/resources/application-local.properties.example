# PLANTILLA DE CONFIGURACIÓN LOCAL (Botica Ahorro y Salud)
# Copia este archivo como 'application-local.properties' y
# coloca las credenciales compartidas por el equipo:
# ─────────────────────────────────────────────────────────

# Contraseña de la base de datos MySQL en Aiven Cloud
spring.datasource.password=PEGA_AQUI_PASSWORD_AIVEN

# Contraseña de Mailtrap para recepción de códigos OTP
spring.mail.password=PEGA_AQUI_PASSWORD_MAILTRAP
